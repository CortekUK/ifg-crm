# ============================================
# IFG CRM Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# ============================================
# SUPABASE - Core Database & Auth
# ============================================
# Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (public - for client-side auth)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (SECRET - for server-side operations)
# Used by: cron jobs, webhooks, Edge Functions
# Get this from: Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# SUPABASE CLI - For Migrations & Deployments
# ============================================
# Personal access token for Supabase CLI
# Generate at: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=your-access-token

# Supabase project ID (from project URL)
SUPABASE_PROJECT_ID=your-project-id

# ============================================
# RESEND - Email Sending Service
# ============================================
# Resend API key for sending emails
# Get this from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Default fallback FROM address (must be on a verified domain in Resend).
# Automation emails use the deal owner's actual email instead — this is only
# the fallback when an owner profile has no email.
FROM_EMAIL=admin@theinternationalfootballgroup.com

# Resend webhook secret for signature verification
# Get this from: Resend Dashboard > Webhooks > Your webhook > Signing secret
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
# Signing secret for the email.delivered/opened/clicked/bounced webhook that
# posts to /api/webhooks/resend (Vercel). This is a DIFFERENT secret from
# RESEND_WEBHOOK_SECRET above, which belongs to the email.received (inbound
# reply) webhook on the Supabase edge function. Using one value for both is
# why no email was ever marked delivered/opened/clicked: every event was
# rejected 401. Copy it from Resend -> Webhooks -> the /api/webhooks/resend
# endpoint -> Signing Secret, and set it in the Vercel project env too.
RESEND_EVENTS_WEBHOOK_SECRET=whsec_...

# ============================================
# SCOUT - AI Assistant (OpenAI)
# ============================================
# OpenAI API key for the Scout super_admin assistant.
# Get this from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# Optional override — defaults to gpt-4o (best general tool-use model).
# OPENAI_MODEL=gpt-4o

# ============================================
# CRON & WEBHOOKS - Automation Backend
# ============================================
# Secret for authenticating cron job requests (generate a random string)
# Used by: Vercel Cron to authenticate calls to /api/cron/*
CRON_SECRET=your-random-cron-secret

# Secret for authenticating WordPress webhook requests
# Share this with your WordPress site for the form webhook
WORDPRESS_WEBHOOK_SECRET=your-random-webhook-secret

# Secret for authenticating submissions from the IFG public website.
# Used by: POST /api/public/forms/submit. Must equal the website's
# IFG_FORM_INGEST_SECRET. Generate a long random string.
FORM_INGEST_SECRET=your-random-form-ingest-secret

# Signing key for unsubscribe links (/unsubscribe?c=…&t=…).
#
# REQUIRED, and it must be byte-identical here and in the Supabase edge-function
# secrets. The link is SIGNED by an edge function and VERIFIED by this app — two
# separately-configured environments. If their keys differ by one byte, every
# link is rejected.
#
# This was once documented as optional, because an unset value is derived from
# SUPABASE_SERVICE_ROLE_KEY via a one-way HMAC. True, but not safe: Supabase
# injects its own SUPABASE_SERVICE_ROLE_KEY into the function runtime, and when
# this project moved to the new API key format that value stopped matching the
# one in the web app's environment. Every unsubscribe link in every sent email
# went dead at once, the reader saw "This link isn't valid", and nothing logged
# why. Do not rely on the fallback.
#
# Changing this value invalidates every link already sitting in an inbox.
# Check both sides agree: node scripts/verify-unsubscribe-live.mjs
UNSUBSCRIBE_SECRET=your-random-unsubscribe-secret

# ============================================
# ENVIRONMENT VARIABLES FOR EDGE FUNCTIONS
# ============================================
# These must be set in Supabase Dashboard > Edge Functions > Secrets:
#
# - SUPABASE_URL (automatically set by Supabase)
# - SUPABASE_SERVICE_ROLE_KEY (automatically set by Supabase)
# - RESEND_API_KEY
# - RESEND_WEBHOOK_SECRET
# - FROM_EMAIL
# - NEXT_PUBLIC_APP_URL  (REQUIRED for unsubscribe links and the
#                         List-Unsubscribe header to resolve. Without it the
#                         functions emit no unsubscribe link at all, which is
#                         both a compliance problem and a deliverability one.)
# - UNSUBSCRIBE_SECRET   (REQUIRED, and byte-identical to the value in this
#                         file. The functions sign the link, the web app
#                         verifies it — see the note above.)
#
# Set them via CLI:
#   supabase secrets set RESEND_API_KEY=re_xxx
#   supabase secrets set RESEND_WEBHOOK_SECRET=whsec_xxx
#   supabase secrets set FROM_EMAIL=notifications@mail.yourdomain.com
#   supabase secrets set NEXT_PUBLIC_APP_URL=https://your-crm-host
#   supabase secrets set UNSUBSCRIBE_SECRET=<the same value as above>

# ============================================
# PUBLIC WEBSITE
# ============================================
# The site students see — brochure flipbooks (/b/<slug>), programme pages,
# application forms. This is NOT the CRM: NEXT_PUBLIC_APP_URL is the CRM and
# is used to resolve image assets inside emails.
#
# Brochure links in automated emails are built from this, so when the client's
# own domain goes live, change it here (and in Vercel) rather than editing code.
#
# That has now happened: www.theinternationalfootballgroup.com is live and
# serving. The old Vercel URL still answers, so nothing is broken — but every
# brochure link, and the "book a call" fallback used for a recruiter with no
# Calendly set, goes out to players pointing at the unbranded preview domain.
# NEXT_PUBLIC_SITE_URL must be updated in the Vercel project settings too;
# changing it here only affects local runs.
NEXT_PUBLIC_SITE_URL=https://www.theinternationalfootballgroup.com
