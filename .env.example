# ============================================
# IFG CRM Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# ============================================
# SUPABASE - Core Database & Auth
# ============================================
# Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (public - for client-side auth)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (SECRET - for server-side operations)
# Used by: cron jobs, webhooks, Edge Functions
# Get this from: Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# SUPABASE CLI - For Migrations & Deployments
# ============================================
# Personal access token for Supabase CLI
# Generate at: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=your-access-token

# Supabase project ID (from project URL)
SUPABASE_PROJECT_ID=your-project-id

# ============================================
# RESEND - Email Sending Service
# ============================================
# Resend API key for sending emails
# Get this from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Default fallback FROM address (must be on a verified domain in Resend).
# Automation emails use the deal owner's actual email instead — this is only
# the fallback when an owner profile has no email.
FROM_EMAIL=admin@theinternationalfootballgroup.com

# Resend webhook secret for signature verification
# Get this from: Resend Dashboard > Webhooks > Your webhook > Signing secret
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# ============================================
# SCOUT - AI Assistant (OpenAI)
# ============================================
# OpenAI API key for the Scout super_admin assistant.
# Get this from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# Optional override — defaults to gpt-4o (best general tool-use model).
# OPENAI_MODEL=gpt-4o

# ============================================
# CRON & WEBHOOKS - Automation Backend
# ============================================
# Secret for authenticating cron job requests (generate a random string)
# Used by: Vercel Cron to authenticate calls to /api/cron/*
CRON_SECRET=your-random-cron-secret

# Secret for authenticating WordPress webhook requests
# Share this with your WordPress site for the form webhook
WORDPRESS_WEBHOOK_SECRET=your-random-webhook-secret

# ============================================
# ENVIRONMENT VARIABLES FOR EDGE FUNCTIONS
# ============================================
# These must be set in Supabase Dashboard > Edge Functions > Secrets:
#
# - SUPABASE_URL (automatically set by Supabase)
# - SUPABASE_SERVICE_ROLE_KEY (automatically set by Supabase)
# - RESEND_API_KEY
# - RESEND_WEBHOOK_SECRET
# - FROM_EMAIL
#
# Set them via CLI:
#   supabase secrets set RESEND_API_KEY=re_xxx
#   supabase secrets set RESEND_WEBHOOK_SECRET=whsec_xxx
#   supabase secrets set FROM_EMAIL=notifications@mail.yourdomain.com
